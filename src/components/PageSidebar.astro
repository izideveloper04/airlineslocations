---
import type { WPPage } from "../lib/wp";

interface Props {
  /** This child page's siblings, already filtered to *-child.php templates by the caller. */
  pages: WPPage[];
}

const { pages } = Astro.props;
---

{pages.length > 0 && (
  <nav aria-label="In this section" class="border border-ink/10 rounded-2xl p-4 bg-white shadow-sm sticky top-20 self-start">
    <h2 class="text-sm font-bold uppercase tracking-wide text-ink/60 mb-3">In this section</h2>
    <ul class="space-y-1">
      {pages.map((page) => (
        <li>
          <a href={`/${page.fullPath}`} class="block rounded px-2 py-1.5 text-sm text-ink/80 hover:bg-surface hover:text-brand transition-colors">
            {page.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
