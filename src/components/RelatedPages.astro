---
import type { WPPage } from "../lib/wp";
import fallbackImage from "../assets/images/airpp.webp";

interface Props {
  /** This parent page's direct children — rendered as a thumbnail + title card grid. */
  pages: WPPage[];
}

const { pages } = Astro.props;
---

{pages.length > 0 ? (
  <div class="card-grid">
    {pages.map((page) => (
      <a href={`/${page.fullPath}`} class="card" data-title={page.title.toLowerCase()}>
        <div class="card__media">
          <img
            src={page.featuredImage ?? fallbackImage.src}
            alt=""
            width="640"
            height="400"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="card__body">
          <p class="card__title">{page.title}</p>
        </div>
      </a>
    ))}
  </div>
) : (
  <p class="text-ink/60 text-sm py-8 text-center">No pages have been published under this section yet.</p>
)}
