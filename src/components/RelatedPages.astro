---
import type { WPPage } from "../lib/wp";
import fallbackImage from "../assets/images/airpp.webp";

interface Props {
  /** This parent page's direct children — rendered as a thumbnail + title card grid. */
  pages: WPPage[];
}

const { pages } = Astro.props;
---

{pages.length > 0 && (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {pages.map((page) => (
      <a
        href={`/${page.fullPath}`}
        class="group block rounded-xl border border-ink/10 bg-white overflow-hidden shadow-sm hover:border-brand-light hover:shadow-md transition-[border-color,box-shadow] duration-200"
      >
        <div class="aspect-[4/3] bg-surface">
          <img
            src={page.featuredImage ?? fallbackImage.src}
            alt={page.title}
            width="640"
            height="480"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
        <h3 class="font-semibold text-ink group-hover:text-brand transition-colors p-4">{page.title}</h3>
      </a>
    ))}
  </div>
)}
