---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageSidebar from "../components/PageSidebar.astro";
import FeaturedImage from "../components/FeaturedImage.astro";
import type { WPPage, PageTree, ResolvedPageMeta } from "../lib/wp";
import { getAncestorChain, getSiblings, isChildTemplate } from "../lib/wp";
import { supportPhone } from "../lib/config";

interface Props {
  page: WPPage;
  tree: PageTree;
  meta: ResolvedPageMeta;
}

const { page, tree, meta } = Astro.props;
const ancestors = getAncestorChain(page, tree);
// Siblings under the same parent are already expected to share the child
// template by convention, but filter explicitly so the sidebar only ever
// shows *-child.php pages even if a sibling is ever assigned something else.
// Newest-published first, capped at 12 — this list has no natural size
// limit otherwise (it grows with every *-child.php page published).
const siblings = (await getSiblings(page.id))
  .filter((sibling) => isChildTemplate(sibling.template))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 12);

const breadcrumbItems = [
  ...ancestors.map((ancestor) => ({ label: ancestor.title, href: `/${ancestor.fullPath}` })),
  { label: page.title },
];

const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogTitle={meta.ogTitle}
  ogDescription={meta.ogDescription}
  ogImage={meta.ogImage}
  schema={meta.schema}
>
  <div class="page-hero">
    <div class="page-hero__main">
      <Breadcrumbs items={breadcrumbItems} />
      <h1 class="page-hero__title">{page.title}</h1>
    </div>

    <div class="call-card">
      <h3 class="call-card__heading">Flight Queries? Call an Expert</h3>
      <a href={supportPhone.href} class="call-card__number">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1L6.6 10.8Z" />
        </svg>
        <span>{supportPhone.display}</span>
      </a>
      <p class="call-card__note">Booking, Cancellation, Refund &amp; Flight Change</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <article class="md:col-span-2">
      <div class="prose" set:html={page.content} />
    </article>
    <PageSidebar pages={siblings} />
  </div>
</BaseLayout>
