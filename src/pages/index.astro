---
// Hand-built landing page. SSR (prerender = false) so the airline directory
// count/list below never goes stale between deploys.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { getPagesByTemplateSuffix, getPosts } from "../lib/wp";
import fallbackImage from "../assets/images/airpp.webp";

Astro.response.headers.set("Cache-Control", "no-store");

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Airlines Locations",
  url: Astro.site?.toString(),
};

// Same query the /airlines directory page uses — one live fetch, reused for
// both the hero's "N airlines listed" trust line and the featured carousel
// below, instead of fetching twice.
// Each call degrades to an empty list on its own rather than failing the
// whole page — unlike /airlines or a WP content page (which exist purely to
// show this data, so a WP outage should fail loudly there), the homepage
// has its own standalone hero/sections and shouldn't go down site-wide over
// a WordPress hiccup.
const [airlines, latestPosts] = await Promise.all([
  getPagesByTemplateSuffix("airlines-parent.php").catch(() => []),
  getPosts().catch(() => []),
]);

const featuredAirlines = airlines.slice(0, 8);
const newsItems = latestPosts.slice(0, 4);
const postDateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
  title="Airlines Locations — Find Airlines and Their Locations Worldwide"
  description="Search airlines and find their offices, contact details, and locations in one directory."
  fullBleed
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />

  <!-- =========================================================
       1. HERO
  ========================================================== -->
  <section class="hero">
    <div class="hero__bg hero__bg--gradient">
      <svg class="route-art" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true">
        <path id="hero-route-path" d="M 30 160 Q 300 20 570 160" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round" />
        <circle cx="30" cy="160" r="6" fill="#fff" />
        <circle cx="30" cy="160" r="6" fill="#fff" class="route-pulse" />
        <circle cx="570" cy="160" r="6" fill="#fff" />
        <circle cx="570" cy="160" r="6" fill="#fff" class="route-pulse" />
        <path class="route-plane" d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(-11 -11) scale(1.1)" />
      </svg>
      <div class="hero__scrim"></div>
    </div>

    <div class="hero__content">
      <p class="hero__eyebrow">Airlines Locations</p>
      <h1 class="hero__headline">Every airline. Every location.</h1>
      <p class="hero__subtext">Search verified contact details, offices, and locations for airlines around the world — all in one directory.</p>

      <div class="hero__panel">
        <form class="hero__search" action="/airlines" method="get">
          <label for="hero-search-input" class="visually-hidden">Search airlines by name</label>
          <input id="hero-search-input" name="q" type="text" placeholder="Search airlines by name…" autocomplete="off" />
          <button type="submit">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
            <span>Search</span>
          </button>
        </form>
        {airlines.length > 0 && (
          <p class="hero__trust">
            {airlines.length} airline{airlines.length === 1 ? "" : "s"} listed and counting — <a href="/airlines">browse them all →</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- =========================================================
       2. ABOUT / INTRO
  ========================================================== -->
  <section class="welcome-section">
    <div class="welcome-section__inner">
      <div class="welcome-content">
        <h2>One place for every airline you need to reach</h2>
        <p>Airlines Locations brings together contact details, offices, and locations for airlines worldwide, so you can find what you need without digging through a dozen different websites.</p>

        <ul class="welcome-stats">
          <li>
            <span class="welcome-stats__value">{airlines.length}</span>
            <span class="welcome-stats__label">Airlines listed</span>
          </li>
          <li>
            <span class="welcome-stats__value">Free</span>
            <span class="welcome-stats__label">Always free to search</span>
          </li>
          <li>
            <span class="welcome-stats__value">24/7</span>
            <span class="welcome-stats__label">Available whenever you need it</span>
          </li>
        </ul>

        <a class="btn btn--primary" href="/airlines">Browse all airlines →</a>
      </div>

      <div class="welcome-panel">
        <p class="welcome-panel__eyebrow">Recently added</p>
        {featuredAirlines.length > 0 ? (
          <ul class="welcome-panel__list">
            {featuredAirlines.slice(0, 5).map((page) => (
              <li>
                <a href={`/${page.fullPath}`}>{page.title}</a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-ink/60 text-sm">No airlines listed yet — check back soon.</p>
        )}
      </div>
    </div>
  </section>

  <!-- =========================================================
       3. FEATURED AIRLINES
  ========================================================== -->
  <section class="guide-section" id="featured-airlines">
    <div class="guide-section__header">
      <h2>Featured airlines</h2>
    </div>

    {featuredAirlines.length > 0 ? (
      <Fragment>
        <div class="guide-track">
          {featuredAirlines.map((page) => (
            <a class="guide-card guide-card--plain" href={`/${page.fullPath}`}>
              <span class="guide-card__title">{page.title}</span>
              <span class="guide-card__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="guide-nav">
          <button type="button" class="guide-nav__btn" data-slide="prev" aria-label="Previous">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
          </button>
          <button type="button" class="guide-nav__btn" data-slide="next" aria-label="Next">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </button>
        </div>
      </Fragment>
    ) : (
      <p class="text-ink/60">No airlines listed yet — check back soon.</p>
    )}
  </section>

  <!-- =========================================================
       4. WHY USE AIRLINES LOCATIONS
  ========================================================== -->
  <section class="essentials">
    <h2>Why use Airlines Locations</h2>

    <div class="essentials__grid">
      <article class="essentials__card">
        <div class="essentials__card-icon">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z" /><path d="m9 12 2 2 4-4" /></svg>
        </div>
        <div class="essentials__body">
          <p class="essentials__label">Verified details</p>
          <p class="essentials__desc">Every listing is checked so the contact details and locations you find here are accurate and current.</p>
        </div>
      </article>

      <article class="essentials__card">
        <div class="essentials__card-icon">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z" /></svg>
        </div>
        <div class="essentials__body">
          <p class="essentials__label">Global coverage</p>
          <p class="essentials__desc">From major carriers to regional airlines, search across locations worldwide in one directory.</p>
        </div>
      </article>

      <article class="essentials__card">
        <div class="essentials__card-icon">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9Z" /></svg>
        </div>
        <div class="essentials__body">
          <p class="essentials__label">Always free</p>
          <p class="essentials__desc">No account, no paywall — search and browse the full directory at no cost, any time.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- =========================================================
       5. HOW IT WORKS
  ========================================================== -->
  <section class="info-section">
    <div class="info-section__text">
      <p class="info-section__eyebrow">Simple by design</p>
      <h2>Finding an airline's details takes three steps</h2>
    </div>
    <div class="info-section__aside">
      <ol class="info-steps">
        <li><span class="info-steps__num">1</span><span>Search or browse the directory by airline name.</span></li>
        <li><span class="info-steps__num">2</span><span>Open a listing to see its offices, contact details, and locations.</span></li>
        <li><span class="info-steps__num">3</span><span>Reach out directly — no middleman, no sign-up.</span></li>
      </ol>
      <div class="info-section__actions">
        <a class="btn btn--primary" href="/airlines">Browse all airlines →</a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       6. FOR AIRLINES
  ========================================================== -->
  <section class="accessibility">
    <div class="accessibility__inner">
      <div class="accessibility__content">
        <h2>Are you an airline?</h2>
        <p>If your airline isn't listed yet, or your details have changed, we'd like to hear from you — get your locations and contact information added or updated on Airlines Locations.</p>
        <div class="accessibility__actions">
          <a class="btn btn--primary" href="mailto:hello@airlineslocations.com">Get listed →</a>
          <a class="btn btn--outline" href="/airlines">See current listings →</a>
        </div>
      </div>
      <div class="accessibility__image">
        <div class="accessibility__panel">
          <span class="accessibility__panel-value">{airlines.length}</span>
          <span class="accessibility__panel-label">airline{airlines.length === 1 ? "" : "s"} already listed</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       7. FROM THE BLOG
  ========================================================== -->
  <section class="news-section">
    <h2>From the blog</h2>

    {newsItems.length > 0 ? (
      <div class="news-grid">
        {newsItems.map((post) => (
          <article class="news-card">
            <a href={`/blog/${post.slug}`} class="news-card__media">
              <img src={post.featuredImage ?? fallbackImage.src} alt="" width="500" height="360" loading="lazy" decoding="async">
            </a>
            <h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3>
            <time datetime={post.date} class="news-card__date">{postDateFormatter.format(new Date(post.date))}</time>
            <div class="news-card__excerpt" set:html={post.excerpt} />
            <a href={`/blog/${post.slug}`} class="news-card__cta">Read more →</a>
          </article>
        ))}
      </div>
    ) : (
      <p class="news-section__empty">No posts published yet — check back soon.</p>
    )}
  </section>

  <script>
    // ---- Featured-airlines slider: horizontal scroll-snap, no carousel library ----
    const guideTrack = document.querySelector<HTMLElement>(".guide-track");
    const slideButtons = document.querySelectorAll<HTMLButtonElement>(".guide-nav__btn[data-slide]");

    function updateSlideButtons() {
      if (!guideTrack) return;
      const atStart = guideTrack.scrollLeft <= 4;
      const atEnd = guideTrack.scrollLeft >= guideTrack.scrollWidth - guideTrack.clientWidth - 4;
      slideButtons.forEach((button) => {
        button.disabled = button.dataset.slide === "prev" ? atStart : atEnd;
      });
    }

    slideButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!guideTrack) return;
        const card = guideTrack.querySelector<HTMLElement>(".guide-card");
        const amount = (card?.getBoundingClientRect().width ?? 220) + 18;
        guideTrack.scrollBy({ left: button.dataset.slide === "prev" ? -amount : amount, behavior: "smooth" });
      });
    });

    guideTrack?.addEventListener("scroll", updateSlideButtons, { passive: true });
    updateSlideButtons();
  </script>
</BaseLayout>
