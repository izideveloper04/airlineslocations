---
// Hand-built landing page. SSR (prerender = false) so the directory data
// below never goes stale between deploys.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedImage from "../components/FeaturedImage.astro";
import { getPageTree, getPosts, isChildTemplate } from "../lib/wp";
import heroImage from "../assets/images/airpp.webp";

Astro.response.headers.set("Cache-Control", "no-store");

const siteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Airlines Locations",
  url: Astro.site?.toString(),
};

// One shared page-tree fetch, reused for "Latest Pages" below (both the list
// itself and each card's parent-title lookup). Each call degrades to an
// empty list/null on its own rather than failing the whole page - the
// homepage has its own standalone sections and shouldn't go down site-wide
// over a WordPress hiccup.
const [tree, latestPosts] = await Promise.all([
  getPageTree().catch(() => null),
  getPosts().catch(() => []),
]);

// Every *-child.php page sitewide, newest first - the naming convention
// shared with ChildPageLayout's sidebar (see src/lib/wp.ts). Each card also
// shows its parent page's title (e.g. the airline a location belongs to) as
// a listing-style category line, purely presentational - looked up from the
// already-fetched tree, no extra query.
const latestChildPages = tree
  ? tree.list.filter((p) => isChildTemplate(p.template)).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 16)
  : [];
const parentTitleOf = (parentId: number) => (tree ? tree.byId.get(parentId)?.title : undefined);

const newsItems = latestPosts.slice(0, 3);
const postDateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<BaseLayout
  title="Find Airlines and Their Locations Worldwide | Airlines Locations"
  description="Search airlines and find their offices, contact details, and locations in one directory."
  fullBleed
>
  <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} is:inline />

  <!-- ========================= HERO ========================== -->
  <section class="hero" style={`background-image:url(${heroImage.src})`}>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-text">
        <span class="hero-eyebrow">Explore the World</span>
        <h1>Everything You Need to Know, All in One Place</h1>
        <p>
          Discover useful information, guides, destinations, and resources to help you plan your next journey.
        </p>
      </div>

      <div class="hero-search-card">
        <h2>Search Airlines</h2>
        <form class="search-form" action="/airlines" method="get">
          <label for="hero-search-input" class="visually-hidden">Search airlines by name</label>
          <div class="search-form__field">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" stroke-linecap="round" />
            </svg>
            <input id="hero-search-input" name="q" type="text" placeholder="Search airlines by name…" autocomplete="off" />
          </div>
          <button type="submit">Search</button>
        </form>
        <a href="#" class="btn btn-primary">Call Now</a>
      </div>
    </div>
  </section>

  <!-- ========================= USP / FEATURE CARDS ========================== -->
  <section class="usp-section">
    <div class="container">
      <div class="usp-grid">
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <div class="usp-card-title">
            <h3>Reliable Information</h3>
            <span class="usp-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
          <p>Get accurate and useful information presented in a simple and easy-to-understand way.</p>
        </div>
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9Z" />
          </svg>
          <div class="usp-card-title">
            <h3>Worldwide Coverage</h3>
            <span class="usp-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
          <p>Explore destinations and resources from locations around the world.</p>
        </div>
        <div class="usp-card">
          <svg class="usp-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          <div class="usp-card-title">
            <h3>Easy to Explore</h3>
            <span class="usp-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </span>
          </div>
          <p>Quickly find the information you need with our clean and user-friendly website.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Display latest pages -->
  <section class="latest-pages-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-eyebrow">Discover More</span>
        <h2>Latest Pages</h2>
        <p>Explore our latest pages and discover helpful information and resources.</p>
      </div>
      {latestChildPages.length > 0 ? (
        <div class="pages-grid">
          {latestChildPages.map((page) => (
            <article class="page-card">
              <a href={`/${page.fullPath}`}>
                <div class="page-card-image">
                  <FeaturedImage src={page.featuredImage} />
                </div>
                <div class="page-card-content">
                  {parentTitleOf(page.parent) && <span class="blog-meta">{parentTitleOf(page.parent)}</span>}
                  <h3>{page.title}</h3>
                  <span class="read-more">Read More →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center" style="color:#667085">No pages have been published yet.</p>
      )}
    </div>
  </section>

  <!-- ========================= ABOUT US ========================== -->
  <section class="about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <img
            src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1200&q=80"
            alt="World map and travel planning"
            loading="lazy"
          />
        </div>
        <div class="about-content">
          <span class="section-eyebrow">About Us</span>
          <h2>Helping You Explore With Confidence</h2>
          <p>
            We are dedicated to providing useful, accessible, and easy-to-understand information for travelers around
            the world.
          </p>
          <p>
            Our goal is to bring important travel information together in one convenient place, helping you make
            better decisions before and during your journey.
          </p>
          <a href="#" class="btn btn-primary">Learn About Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Display latest blog -->
  <section class="latest-blog-section">
    <div class="container">
      <div class="section-heading">
        <span class="section-eyebrow">From Our Blog</span>
        <h2>Latest Blog Posts</h2>
        <p>Read our latest articles, guides, tips, and travel stories.</p>
      </div>
      {newsItems.length > 0 ? (
        <div class="blog-grid">
          {newsItems.map((post) => (
            <article class="blog-card">
              <a href={`/blog/${post.slug}`}>
                <div class="blog-image">
                  <FeaturedImage src={post.featuredImage} />
                </div>
              </a>
              <div class="blog-content">
                <time datetime={post.date} class="blog-meta">{postDateFormatter.format(new Date(post.date))}</time>
                <h3>
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h3>
                <div set:html={post.excerpt} />
                <a href={`/blog/${post.slug}`} class="read-more">Read Article →</a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-center" style="color:#667085">No blog posts published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>
