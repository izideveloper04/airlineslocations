---
// Hand-built listing page (not a single WP record) — lists published WP
// posts as cards, newest first. "blog" is reserved in RESERVED_SLUGS
// (wp.ts) so a WP page can never shadow this route. Each card links to
// src/pages/blog/[slug].astro for the full post. Reuses the same .card
// styling as the homepage's "From the blog" section (src/styles/global.css)
// so a post looks the same whether it's found there or on this full listing.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getPosts } from "../lib/wp";
import FeaturedImage from "../components/FeaturedImage.astro";

const posts = await getPosts();

const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout title="Blog | Airlines Locations" description="News and updates from Airlines Locations.">
  <div class="page-hero">
    <div class="page-hero__main">
      <Breadcrumbs items={[{ label: "Blog" }]} />
      <h1 class="page-hero__title">Blog</h1>
      <p class="text-sm text-ink/60 mt-2">
        {posts.length} {posts.length === 1 ? "post" : "posts"} published.
      </p>
    </div>
  </div>

  {posts.length > 0 ? (
    <div class="card-grid">
      {posts.map((post) => (
        <article class="card">
          <a href={`/blog/${post.slug}`} class="card__media">
            <FeaturedImage src={post.featuredImage} />
          </a>
          <div class="card__body">
            <p class="card__title"><a href={`/blog/${post.slug}`}>{post.title}</a></p>
            <time datetime={post.date} class="card__meta block mt-1">{dateFormatter.format(new Date(post.date))}</time>
            <div class="card__excerpt" set:html={post.excerpt} />
            <a href={`/blog/${post.slug}`} class="card__cta">Read more →</a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="text-ink/60 text-sm">No posts published yet.</p>
  )}
</BaseLayout>
