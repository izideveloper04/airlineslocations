---
// Hand-built directory page (not a single WP record) — lists every page
// using an "airlines-child.php" template, regardless of where each one
// sits in the page tree. Airlines pages are flat now (no airlines-parent.php
// section-parent above them) — this still works unchanged either way, since
// getPagesByTemplateSuffix matches by template, not by tree position.
// "airlines" is reserved in RESERVED_SLUGS (wp.ts) so a WP page can never
// shadow this route.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getPagesByTemplateSuffix } from "../lib/wp";

const airlines = await getPagesByTemplateSuffix("airlines-parent.php");

// Backs the homepage hero's search box (GET /airlines?q=...) as well as an
// on-page search here — filtered server-side since the full list is
// already fetched, no separate search endpoint needed.
const query = Astro.url.searchParams.get("q")?.trim() ?? "";
const results = query ? airlines.filter((page) => page.title.toLowerCase().includes(query.toLowerCase())) : airlines;

Astro.response.headers.set("Cache-Control", "no-store");
---

<BaseLayout title="Airlines | Airlines Locations" description="Airlines operating at Airlines Locations.">
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Airlines" }]} />
  <h1 class="text-3xl font-bold mb-6">Airlines</h1>

  <!-- Same search control as the homepage hero (.hero-search, global.css) —
       one search affordance, styled identically wherever it appears. -->
  <form class="hero-search mb-8" method="get">
    <label for="airlines-search-input" class="sr-only">Search airlines by name</label>
    <input id="airlines-search-input" name="q" type="text" value={query} placeholder="Search airlines by name…" autocomplete="off" />
    <button type="submit">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
      <span>Search</span>
    </button>
  </form>

  {results.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {results.map((page) => (
        <a href={`/${page.fullPath}`} class="ticket-stub">
          <span class="ticket-stub__main">{page.title}</span>
          <span class="ticket-stub__tear" aria-hidden="true"></span>
          <span class="ticket-stub__end" aria-hidden="true">
            <svg class="ticket-stub__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  ) : query ? (
    <p class="text-ink/70">No airlines matching "{query}".</p>
  ) : (
    <p class="text-ink/70">No airlines listed yet.</p>
  )}
</BaseLayout>
